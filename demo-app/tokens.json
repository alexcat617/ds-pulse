{
  "name": "Apex UI",
  "colors": {
    "primary": "#4F46E5",
    "primaryHover": "#4338CA",
    "surface": "#FFFFFF",
    "background": "#F8FAFC",
    "textPrimary": "#0F172A",
    "textSecondary": "#64748B",
    "border": "#E2E8F0",
    "success": "#10B981",
    "danger": "#EF4444"
  },
  "fontSizes": ["12px", "14px", "16px", "24px"],
  "borderRadii": ["6px", "12px"],
  "allowedComponents": [".ds-btn", ".ds-card", ".ds-input", ".ds-badge"],
  "components": {
    "button": {
      "baseClass": "ds-btn",
      "fallbackVariant": "primary",
      "variants": {
        "primary": {
          "matchAnyClass": ["ds-btn--primary"],
          "default": {
            "backgroundColor": "primary",
            "color": "surface"
          }
        },
        "secondary": {
          "matchAnyClass": ["ds-btn--secondary"],
          "default": {
            "backgroundColor": "surface",
            "color": "textPrimary",
            "borderColor": "border"
          }
        }
      }
    }
  }
}